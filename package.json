{
  "name": "room-to-grow",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @room-to-grow/web dev",
    "dev:cms": "pnpm --filter @room-to-grow/cms dev",
    "build": "pnpm --filter @room-to-grow/web build",
    "build:embed": "pnpm --filter @room-to-grow/web build:embed",
    "build:cms": "pnpm --filter @room-to-grow/cms build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@swc/core"
    ]
  }
}
