{
  "name": "room-to-grow",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @room-to-grow/web dev",
    "build": "pnpm --filter @room-to-grow/web build",
    "build:embed": "pnpm --filter @room-to-grow/web build:embed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
