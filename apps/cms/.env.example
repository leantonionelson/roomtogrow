# SQLite for local development; swap for Postgres/Mongo in production.
DATABASE_URL=file:./cms.db

# Generate a unique value per environment — never commit the real secret.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Comma-separated origins allowed to read the content API (the embed's host).
# Defaults to "*" when unset.
# CORS_ORIGINS=https://intranet.example.com
